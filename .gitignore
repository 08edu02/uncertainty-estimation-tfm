# --- Datasets ---------------------------------------------------------------
# Raw data is never committed; `scripts/download_data.py` fetches it from the
# official sources. See README for licences. The leading slash keeps the
# pattern anchored to the repository root (so `src/uq/data/` is still code).
/data/

# --- Generated artefacts ----------------------------------------------------
# Figures and raw per-run outputs are regenerated by the scripts; only the
# small JSON summaries under results/ are versioned.
results/figures/
results/raw/
reports/figures/

